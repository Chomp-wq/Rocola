config BR2_PACKAGE_ROCOLA_CONSOLA
	bool "rocola-consola"
	depends on BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_PACKAGE_MESA3D_OPENGL_ES && BR2_PACKAGE_MESA3D_OPENGL_EGL && BR2_PACKAGE_MESA3D_GBM
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_DEJAVU
	select BR2_PACKAGE_JPEG   # las portadas con libjpeg-turbo (si falta, el lector propio)
	help
	  La rocola de Rocola OS (etapa 2): la cadena de sonido de la rocola por ALSA, y su pantalla por KMS y OpenGL ES
	  (o en modo texto).
	  Programa nativo de .NET 10 (NativeAOT); se compila en el equipo que arma el sistema (hace falta el SDK de .NET 10 ahi).
