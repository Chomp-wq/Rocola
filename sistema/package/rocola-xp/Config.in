config BR2_PACKAGE_ROCOLA_XP
	bool "rocola-xp"
	depends on BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_PACKAGE_MESA3D_OPENGL_ES && BR2_PACKAGE_MESA3D_OPENGL_EGL && BR2_PACKAGE_MESA3D_GBM
	depends on BR2_PACKAGE_MPV   # el video: libmpv.so.2 (Buildroot compila mpv con -Dlibmpv=true)
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_MPG123   # el descompresor de MP3 (libmpg123.so.0); su programa suena la cancion de prueba (rocola-prueba)
	select BR2_PACKAGE_DEJAVU   # las letras de repuesto si no estan las de XP (Nativo/Letras.cs)
	help
	  La rocola de XP traducida a Linux (sistema/rocola/Xp, «rocola-xp»): el UNICO programa de Rocola OS desde el 14-11-2026
	  (sistema/INTEGRACION_ROCOLA_XP.md); /usr/bin/rocola la abre siempre. Programa nativo de .NET 10 (NativeAOT) con SkiaSharp
	  (libSkiaSharp.so va a su lado, sin mas dependencias que glibc); se compila en el equipo que arma el sistema (hace falta el SDK
	  de .NET 10 ahi). Pone tambien la cancion de prueba (/usr/share/rocola/prueba.mp3 y el disco «Rocola OS - Prueba»), que antes
	  ponia rocola-consola (retirado).
