config BR2_PACKAGE_LIBRESPOT
	bool "librespot (Spotify en la rocola)"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_OPENSSL
	help
	  Cliente libre de Spotify Connect (no oficial; necesita una
	  cuenta Premium). La rocola lo abre solo con el interruptor
	  «Spotify» de Ctrl+F3 encendido (apagado de fabrica) y toca
	  lo que manda por su cadena de sonido. No guarda musica.

	  https://github.com/librespot-org/librespot
