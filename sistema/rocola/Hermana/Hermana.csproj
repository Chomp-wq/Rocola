<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rocola</RootNamespace>
    <AssemblyName>rocola</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);ROCOLA_GPU</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishAot>true</PublishAot>
    <!-- las llamadas a Windows de la rocola de XP se contestan desde el propio programa (Windows/Enlaces.cs) -->
    <IlcExportUnmanagedEntrypoints>true</IlcExportUnmanagedEntrypoints>
    <NoWarn>CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CA1416;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Rocola/*.cs" LinkBase="XP" />
    <Compile Include="Windows/**/*.cs" />
    <Compile Include="../Consola/Pantalla/Kms.cs" Link="Pantalla/Kms.cs" />
    <Compile Include="../Consola/Pantalla/Gl.cs" Link="Pantalla/Gl.cs" />
    <Compile Remove="Formas/**" />
  </ItemGroup>
  <ItemGroup>
    <RdXmlFile Include="rd.xml" />
    <TrimmerRootAssembly Include="NAudio" />
    <TrimmerRootAssembly Include="NLayer" />
    <LinkerArg Include="-Wl,--export-dynamic" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Formas/Formas.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <Reference Include="NAudio"><HintPath>../../../packages/NAudio.1.9.0/lib/net35/NAudio.dll</HintPath></Reference>
    <Reference Include="NLayer"><HintPath>../../../packages/NLayer.1.12.0/lib/net35/NLayer.dll</HintPath></Reference>
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>
</Project>
