<Project Sdk="Microsoft.NET.Sdk">
  <!-- EL WINFORMS DE ROCOLA OS (sistema/rocola/Hermana/LEEME.md): lo poco de System.Windows.Forms que usa la rocola de XP, hecho aqui
       sobre GDI+ (System.Drawing.Common con libgdiplus), sin Windows. Se llama igual que el de Windows para que el codigo de XP y
       NAudio 1.9 lo encuentren sin cambiar nada. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>CA1416;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>
</Project>
