      <Type Name="NAudio.Wave.Mp3WaveFormat" Dynamic="Required All" MarshalStructure="Required All" />
      <Type Name="NAudio.Wave.WaveFormatExtensible" Dynamic="Required All" MarshalStructure="Required All" />
      <Type Name="NAudio.Wave.AdpcmWaveFormat" Dynamic="Required All" MarshalStructure="Required All" />
      <Type Name="NAudio.Wave.WaveFormatExtraData" Dynamic="Required All" MarshalStructure="Required All" />
      <Type Name="NAudio.Wave.Compression.AcmStreamHeaderStruct" Dynamic="Required All" MarshalStructure="Required All" />
    </Assembly>
    <Assembly Name="NLayer" Dynamic="Required All" />
    <Assembly Name="rocola" Dynamic="Required All" />
  </Application>
</Directives>
