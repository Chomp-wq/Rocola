<Project Sdk="Microsoft.NET.Sdk">
  <!-- LA ROCOLA DE XP TRADUCIDA A LINUX (decision del dueno del 7-11-2026: «que absolutamente todo el codigo lo traduzcas [...] para que
       funcione nativamente en linux, pero que quede identico»; plan en PLAN_TRADUCCION_XP_A_LINUX_MODEST_2026-11-07.md).
       Codigo/ = los archivos de la rocola de XP (Rocola/*.cs) traducidos uno por uno para que llamen directo a lo nativo de Linux;
       Nativo/ = eso nativo (SkiaSharp con las cuentas de GDI+ y GDI, OpenGL ES 2, la pantalla y sus hojas, evdev, ALSA, libmpv);
       Plataforma/ = lo demas de Linux que no es de XP (las teclas de evdev, el MP3 y NAudio 3, NativeAOT y los ganchos de prueba).
       Sin capas que imiten a Windows: Dibujo2D.cs, Ventanas.*.cs, los puentes y el global using se borraron en N7 (13-11-2026). -->
  <PropertyGroup>
    <!-- como el proyecto de XP (Rocola.csproj): la tarjeta grafica (Direct3D 9 en XP; aqui OpenGL ES 2 directo, Nativo/DispositivoTarjetaGl.cs) -->
    <DefineConstants>$(DefineConstants);ROCOLA_GPU</DefineConstants>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>rocola-xp</AssemblyName>
    <RootNamespace>Rocola</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- el codigo de XP trae avisos de .NET 3.5 que aqui no dicen nada (lo obsoleto de .NET 10, variables sin usar de XP) -->
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;SYSLIB0011;SYSLIB0014;CA1416</NoWarn>
    <!-- LA VERSION EN ROCOLA OS (lo que contesta rocola-xp si se le pregunta la version: Nativo/VersionRocolaOs.cs), como Consola.csproj: la pone quien compila
         (-p:RocolaVersion=N -p:RocolaCommit=abc1234); en casa y en el sistema, la 0 («local») -->
    <RocolaVersion Condition="'$(RocolaVersion)' == ''">0</RocolaVersion>
    <RocolaCommit Condition="'$(RocolaCommit)' == ''">local</RocolaCommit>
    <InformationalVersion>$(RocolaVersion)+$(RocolaCommit)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- cuando se compilo (segundos desde 1970, UTC): lo que /usr/bin/rocola y rocola-actualiza leen de «compilado SEGUNDOS» -->
    <RocolaFecha Condition="'$(RocolaFecha)' == ''">$([System.DateTimeOffset]::UtcNow.ToUnixTimeSeconds())</RocolaFecha>
  </PropertyGroup>
  <ItemGroup><AssemblyMetadata Include="RocolaFecha" Value="$(RocolaFecha)" /></ItemGroup>
  <PropertyGroup Condition="'$(RocolaPerfil)' != 'qemu'">
    <IlcInstructionSet>x86-64-v2,avx</IlcInstructionSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="bin/**;obj/**;Referencia/**;Pruebas/**" />
    <!-- la pantalla de Rocola OS (KMS y fuera de pantalla) y OpenGL ES 2 / EGL: los mismos archivos del programa de Linux de ahora, sin cambiarlos -->
    <Compile Include="../Consola/Pantalla/Gl.cs" Link="Plataforma/Enlazados/Gl.cs" />
    <Compile Include="../Consola/Pantalla/Kms.cs" Link="Plataforma/Enlazados/Kms.cs" />
    <Compile Include="../Motor/Botones.cs" Link="Plataforma/Enlazados/Botones.cs" />
  </ItemGroup>
</Project>
