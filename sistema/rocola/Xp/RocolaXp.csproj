<Project Sdk="Microsoft.NET.Sdk">
  <!-- LA ROCOLA DE XP TRADUCIDA A LINUX (decision del dueno del 7-11-2026: «que absolutamente todo el codigo lo traduzcas [...] para que
       funcione nativamente en linux, pero que quede identico»; plan en PLAN_TRADUCCION_XP_A_LINUX_MODEST_2026-11-07.md).
       Codigo/ = los archivos de la rocola de XP (Rocola/*.cs) traducidos uno por uno; Plataforma/ = lo nativo de Linux con que se
       traduce lo de Windows: el dibujo de GDI+ en SkiaSharp, Direct3D 9 en OpenGL ES 2, las teclas por evdev, el sonido por ALSA. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>rocola-xp</AssemblyName>
    <RootNamespace>Rocola</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- el codigo de XP trae avisos de .NET 3.5 que aqui no dicen nada (lo obsoleto de .NET 10, variables sin usar de XP) -->
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;SYSLIB0011;SYSLIB0014;CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RocolaPerfil)' != 'qemu'">
    <IlcInstructionSet>x86-64-v2,avx</IlcInstructionSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="bin/**;obj/**;Referencia/**" />
  </ItemGroup>
</Project>
