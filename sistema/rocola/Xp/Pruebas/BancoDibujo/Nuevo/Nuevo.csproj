<Project Sdk="Microsoft.NET.Sdk">
  <!-- BANCO DEL DIBUJO con las funciones nativas (Xp/Nativo) de esta copia de trabajo: hace los mismos casos que el banco congelado (la
       capa de GDI+ de la referencia, ../Congelado) llamando directo a las funciones nativas, como el codigo de XP traducido. (N7, borrar-capas:
       ya no compila Plataforma/Dibujo2D.cs, borrado, ni su ejecutor «gdi».) Ver Programa.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BancoNuevo</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);NATIVO</DefineConstants>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;CA1416;CA2022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="../Casos.cs;../EjecutaNativo.cs;../Programa.cs" />
    <!-- De Nativo/ solo el dibujo y la tarjeta (lo que el banco compilaba hasta b609319): lo demas que entro despues -el sonido por ALSA,
         el lector de audio y de MP3, el video, la pantalla y las teclas de la rocola- pide el programa entero (NAudio, NLayer, Form1). -->
    <Compile Include="../../../Nativo/CintaTarjeta.cs;../../../Nativo/Degradado.cs;../../../Nativo/FormatoMapa.cs;../../../Nativo/DispositivoTarjetaGl.cs;../../../Nativo/GlMas.cs;../../../Nativo/Imagenes.cs;../../../Nativo/Letras.cs;../../../Nativo/Mapas.cs;../../../Nativo/MemoriaTarjeta.cs;../../../Nativo/PantallaTarjeta.cs;../../../Nativo/Pixel.cs;../../../Nativo/Pixeles.cs;../../../Nativo/RecorteLienzo.cs;../../../Nativo/SombreadoresTarjeta.cs;../../../Nativo/TextoGdi.cs;../../../Nativo/TextoGdiPlus.cs;../../../Nativo/TexturasGl.cs;../../../Nativo/TrazaTarjeta.cs;../../../Nativo/VolcadoTexturas.cs" LinkBase="Nativo" />
  </ItemGroup>
</Project>
