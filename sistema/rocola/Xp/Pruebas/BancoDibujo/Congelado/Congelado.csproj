<Project Sdk="Microsoft.NET.Sdk">
  <!-- BANCO DEL DIBUJO con el Dibujo2D.cs CONGELADO de la referencia (la version con capas, commit aef2211, fuera del repositorio:
       /root/rocola-trabajo/referencia-xp; otra ruta con -p:Referencia=...). Ver Programa.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BancoCongelado</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;CA1416;CA2022</NoWarn>
    <Referencia Condition="'$(Referencia)' == ''">/root/rocola-trabajo/referencia-xp</Referencia>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="../Casos.cs;../EjecutaGdi.cs;../Programa.cs" />
    <Compile Include="$(Referencia)/sistema/rocola/Xp/Plataforma/Dibujo2D.cs" Link="Referencia/Dibujo2D.cs" />
  </ItemGroup>
</Project>
