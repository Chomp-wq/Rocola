<Project Sdk="Microsoft.NET.Sdk">
  <!-- LAS MEDIDAS DE LAS CARATULAS (rapido-caratulas, 20-11-2026; no es de XP ni va en Rocola OS): el programa entero de una carpeta Xp
       (Fuente: esta copia de trabajo, o con -p:Fuente=... otra, p. ej. la base) mas dos archivos de prueba:
         Banco.cs  la orden banco-caratulas (con dos guiones): el camino de cada portada (la miniatura de la original o la guardada, la copia por guardar,
                   la previa, los tonos y la paleta), por partes y con la huella de cada resultado (para comparar dos versiones);
         Mide.cs   la funcion de prueba «medir-caratulas» (solo con ROCOLA_OS=medir-caratulas): con la rocola entera, cuanto tarda cada
                   pagina de la pared en tener sus 18 portadas subidas (la cuenta del regulador de XP, FinishPage) y los cuadros.
       Se publica en NativeAOT como el programa (dotnet publish -c Release -r linux-x64 -p:PublishAot=true). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rocola-xp</AssemblyName>
    <RootNamespace>Rocola</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);ROCOLA_GPU</DefineConstants>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;SYSLIB0011;SYSLIB0014;SYSLIB0050;SYSLIB0054;CA1416;CA2022;CA2014;CS1690;CS7022</NoWarn>
    <Fuente Condition="'$(Fuente)' == ''">$(MSBuildThisFileDirectory)../..</Fuente>
    <IlcInstructionSet>x86-64-v2,avx</IlcInstructionSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="$(Fuente)/Codigo/**/*.cs;$(Fuente)/Plataforma/**/*.cs;$(Fuente)/Nativo/**/*.cs;$(Fuente)/RocolaOs/**/*.cs" Exclude="$(Fuente)/**/bin/**;$(Fuente)/**/obj/**" />
    <Compile Include="$(Fuente)/../Consola/Pantalla/Gl.cs;$(Fuente)/../Consola/Pantalla/Kms.cs;$(Fuente)/../Motor/Botones.cs" />
    <!-- al final: sus inicializadores corren despues de los del programa (las funciones de Rocola OS ya registradas) -->
    <Compile Include="Banco.cs;BancoDct.cs;Mide.cs" />
  </ItemGroup>
</Project>
