<Project Sdk="Microsoft.NET.Sdk">
  <!-- la carpeta del programa (Nativo/CarpetaPrograma.cs, el mismo archivo del programa) contra lo que daba la capa de la transicion
       (Application.StartupPath de Plataforma/Ventanas.Form.cs: su cuenta la copia guiones/pruebas_carpeta.sh en Capa.cs) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Rocola</RootNamespace>
    <AssemblyName>PruebasCarpeta</AssemblyName>
    <!-- IL3000: Assembly.Location con NativeAOT sale vacio; la prueba lo lee a proposito para ensenarlo -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Nativo/CarpetaPrograma.cs" Link="Nativo/CarpetaPrograma.cs" />
  </ItemGroup>
</Project>
