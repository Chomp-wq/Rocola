<Project Sdk="Microsoft.NET.Sdk">
  <!-- pruebas pequenas de la capa de ventanas (Ventanas.*.cs) contra lo que hace WinForms; Rocola=carpeta del rocola-xp.dll a probar -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
    <!-- el programa con las teclas nativas (Tecla, ventanas2 T): Nativo=true -->
    <DefineConstants Condition="'$(Nativo)' == 'true'">$(DefineConstants);NATIVO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="rocola-xp"><HintPath>$(Rocola)/rocola-xp.dll</HintPath></Reference>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>
</Project>
