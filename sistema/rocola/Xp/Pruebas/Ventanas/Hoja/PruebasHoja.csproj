<Project Sdk="Microsoft.NET.Sdk">
  <!-- las reglas de la hoja nativa y sus piezas (Nativo/Hoja*.cs, Pieza.cs, Rotulo.cs, BotonXp.cs, ListaXp.cs, AvisoXp.cs, SelectorCarpetas.cs,
       PinturaXp.cs), una por una, con esos mismos archivos del programa y los de la pantalla y el dibujo nativos que usan (port nativo, ventanas2 H) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Rocola</RootNamespace>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Nativo/PantallaRocola.cs" Link="Nativo/PantallaRocola.cs" />
    <Compile Include="../../../Nativo/PantallaRocola.Teclado.cs" Link="Nativo/PantallaRocola.Teclado.cs" />
    <Compile Include="../../../Nativo/Reloj.cs" Link="Nativo/Reloj.cs" />
    <Compile Include="../../../Nativo/Tecla.cs" Link="Nativo/Tecla.cs" />
    <Compile Include="../../../Nativo/Hoja.cs" Link="Nativo/Hoja.cs" />
    <Compile Include="../../../Nativo/Hoja.Foco.cs" Link="Nativo/Hoja.Foco.cs" />
    <Compile Include="../../../Nativo/Hoja.Entrada.cs" Link="Nativo/Hoja.Entrada.cs" />
    <Compile Include="../../../Nativo/Hoja.Pinta.cs" Link="Nativo/Hoja.Pinta.cs" />
    <Compile Include="../../../Nativo/Pieza.cs" Link="Nativo/Pieza.cs" />
    <Compile Include="../../../Nativo/Rotulo.cs" Link="Nativo/Rotulo.cs" />
    <Compile Include="../../../Nativo/BotonXp.cs" Link="Nativo/BotonXp.cs" />
    <Compile Include="../../../Nativo/ListaXp.cs" Link="Nativo/ListaXp.cs" />
    <Compile Include="../../../Nativo/AvisoXp.cs" Link="Nativo/AvisoXp.cs" />
    <Compile Include="../../../Nativo/SelectorCarpetas.cs" Link="Nativo/SelectorCarpetas.cs" />
    <Compile Include="../../../Nativo/PinturaXp.cs" Link="Nativo/PinturaXp.cs" />
    <Compile Include="../../../Nativo/Letras.cs" Link="Nativo/Letras.cs" />
    <Compile Include="../../../Nativo/TextoGdi.cs" Link="Nativo/TextoGdi.cs" />
    <Compile Include="../../../Nativo/Pixel.cs" Link="Nativo/Pixel.cs" />
    <Compile Include="../../../Nativo/Degradado.cs" Link="Nativo/Degradado.cs" />
    <Compile Include="../../../Nativo/Mapas.cs" Link="Nativo/Mapas.cs" />
    <Compile Include="../../../Nativo/Imagenes.cs" Link="Nativo/Imagenes.cs" />
  </ItemGroup>
</Project>
