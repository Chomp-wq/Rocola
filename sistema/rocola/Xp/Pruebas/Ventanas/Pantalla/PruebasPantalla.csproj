<Project Sdk="Microsoft.NET.Sdk">
  <!-- las reglas de la pantalla nativa (Nativo/PantallaRocola.cs y Reloj.cs) una por una, con esos mismos archivos del programa -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Rocola</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Nativo/PantallaRocola.cs" Link="Nativo/PantallaRocola.cs" />
    <Compile Include="../../../Nativo/Reloj.cs" Link="Nativo/Reloj.cs" />
  </ItemGroup>
</Project>
