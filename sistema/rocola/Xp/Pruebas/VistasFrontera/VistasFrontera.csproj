<Project Sdk="Microsoft.NET.Sdk">
  <!-- EL ARNES DE LA FRONTERA CON LA TARJETA (port nativo, tanda 2, grupo frontera): el programa entero de una carpeta Xp (Fuente: esta
       copia de trabajo, o con -p:Fuente=... la referencia congelada /root/rocola-trabajo/referencia-xp/sistema/rocola/Xp, sin tocarla)
       con otra entrada (Frontera.cs) que llama con datos fijos a los hornos de D3D9Star.cs, a la subida a la tarjeta y al contador de
       cuadros (EnsureFpsTex), y da la huella de cada mapa y de cada textura subida. Las dos salidas tienen que ser iguales (compara.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VistasFrontera</AssemblyName>
    <RootNamespace>Rocola</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);ROCOLA_GPU</DefineConstants>
    <StartupObject>Banco.Frontera</StartupObject>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;SYSLIB0011;SYSLIB0014;SYSLIB0050;SYSLIB0054;CA1416;CA2014;CA2022;CS1690;CS7022</NoWarn>
    <Fuente Condition="'$(Fuente)' == ''">$(MSBuildThisFileDirectory)../..</Fuente>
    <!-- lo que los arneses usan del dibujo (Pruebas/Comun): la clase Pru de la capa si la carpeta Fuente es la referencia congelada (sin
         Nativo/), y la nativa si es el programa nuevo. ROCOLA_COMUN la pone el guion si el proyecto se copio a otra carpeta -->
    <ComunDir Condition="'$(ComunDir)' == '' And '$(ROCOLA_COMUN)' != ''">$(ROCOLA_COMUN)</ComunDir>
    <ComunDir Condition="'$(ComunDir)' == ''">$(MSBuildThisFileDirectory)../Comun</ComunDir>
    <EsReferencia Condition="!Exists('$(Fuente)/Nativo/Mapas.cs')">true</EsReferencia>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Frontera.cs" />
    <Compile Include="$(ComunDir)/Modos.cs" />
    <Compile Include="$(ComunDir)/PruCapa.cs" Condition="'$(EsReferencia)' == 'true'" />
    <Compile Include="$(ComunDir)/PruNativo.cs" Condition="'$(EsReferencia)' != 'true'" />
    <Compile Include="$(Fuente)/Codigo/**/*.cs;$(Fuente)/Plataforma/**/*.cs;$(Fuente)/Nativo/**/*.cs" Exclude="$(Fuente)/**/bin/**;$(Fuente)/**/obj/**" />
    <Compile Include="$(Fuente)/../Consola/Pantalla/Gl.cs;$(Fuente)/../Consola/Pantalla/Kms.cs;$(Fuente)/../Motor/Botones.cs" />
  </ItemGroup>
</Project>
