<Project Sdk="Microsoft.NET.Sdk">
  <!-- ARNES DEL GRUPO «PORTADAS» (port nativo, tanda 3 del dibujo): el programa entero de una carpeta Xp (Fuente: esta copia de trabajo,
       o con -p:Fuente=/root/rocola-trabajo/referencia-xp/sistema/rocola/Xp la referencia congelada, copiando este proyecto fuera) con otra entrada
       (Portadas.cs) que llama con datos fijos a lo de Form1.Portadas.cs, Form1.Biblioteca.cs, CaratulasAdaptativas.cs y DibujoLigeroGpu.cs (leer,
       reducir, copiar y guardar las miniaturas, las previas y las teselas) y da la huella de cada mapa, de cada archivo y lo que devuelve. Las dos salidas tienen que ser iguales linea por linea. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VistasPortadas</AssemblyName>
    <RootNamespace>Rocola</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);ROCOLA_GPU</DefineConstants>
    <StartupObject>BancoPortadas.Portadas</StartupObject>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;SYSLIB0011;SYSLIB0014;SYSLIB0050;SYSLIB0054;CA1416;CA2022;CA2014;CS1690;CS7022</NoWarn>
    <Fuente Condition="'$(Fuente)' == ''">$(MSBuildThisFileDirectory)../..</Fuente>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Portadas.cs" />
    <Compile Include="$(Fuente)/Codigo/**/*.cs;$(Fuente)/Plataforma/**/*.cs;$(Fuente)/Nativo/**/*.cs" Exclude="$(Fuente)/**/bin/**;$(Fuente)/**/obj/**" />
    <Compile Include="$(Fuente)/../Consola/Pantalla/Gl.cs;$(Fuente)/../Consola/Pantalla/Kms.cs;$(Fuente)/../Motor/Botones.cs" />
  </ItemGroup>
</Project>
