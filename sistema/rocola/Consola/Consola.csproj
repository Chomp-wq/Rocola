<Project Sdk="Microsoft.NET.Sdk">
  <!-- LA ROCOLA SIN PANTALLA (Rocola OS, hito 4 de la etapa 2): toca una lista de canciones por la cadena del motor y ALSA. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>rocola-consola</AssemblyName>
    <RootNamespace>Rocola</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <!-- las instrucciones del A4 (Piledriver): SSE4.2 y AVX (FMA en .NET 10 solo viene con AVX2, que no tiene). El perfil de QEMU
       (RocolaPerfil=qemu) va sin ellas: el emulador no tiene AVX. -->
  <PropertyGroup Condition="'$(RocolaPerfil)' != 'qemu'">
    <IlcInstructionSet>x86-64-v2,avx</IlcInstructionSet>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Motor/Motor.csproj" /></ItemGroup>
</Project>
