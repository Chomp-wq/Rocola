# Lo del A4 encima de la base de PC de Buildroot (board/pc/linux.config).

# Arrancar desde una memoria USB o el SSD (incluidos en el nucleo, sin initramfs)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_EXT4_FS=y

# Botones y teclado (USB HID)
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y

# La grafica del A4 (Radeon HD 8370D, ARUBA): como modulo, para que su firmware ya este en el disco al cargarla
CONFIG_MODULES=y
CONFIG_DRM=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y

# El sonido del A4 (HDA con codec Realtek, y la salida HDMI)
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m

# La red (Realtek, para actualizar mas adelante) y la temperatura del procesador
CONFIG_R8169=m
CONFIG_HWMON=y
CONFIG_SENSORS_K10TEMP=m

# Respuesta: nucleo con expropiacion completa y 1000 Hz (menos latencia para el sonido y la pantalla)
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y

# El procesador siempre a toda velocidad (una rocola no ahorra bateria) y su microcodigo
CONFIG_CPU_FREQ=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_MICROCODE=y

# La musica en otros discos, en SOLO LECTURA (rocola-discos): el disco de Windows XP del A4 (NTFS) y memorias USB (FAT, exFAT)
CONFIG_NTFS3_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"

# Arranque por UEFI (la particion EFI de disk.img): el nucleo como programa EFI y la pantalla de UEFI hasta que entra la Radeon
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FB_EFI=y

# El sistema INSTALADO en el disco de la rocola (rocola-instalar): va en un archivo (sistema.img, ext4) dentro del disco NTFS, junto a
# la musica, sin tocar las particiones. Un initramfs pequeno monta el NTFS, el archivo por loop y arranca desde ahi.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
