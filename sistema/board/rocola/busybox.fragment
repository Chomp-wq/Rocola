# Lo que la prueba de la etapa 1 necesita de busybox, encima de su configuracion de siempre.
CONFIG_TIMEOUT=y
# rocola-discos: saber de que tipo es cada particion para montarla en solo lectura
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_VOLUMEID=y
CONFIG_FEATURE_VOLUMEID_NTFS=y
CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_FEATURE_VOLUMEID_EXFAT=y
CONFIG_FEATURE_VOLUMEID_EXT=y
# El boton de encendido apaga la rocola y el equipo (como el de XP): acpid llama a /etc/acpi/PWRF/00000080
CONFIG_ACPID=y
CONFIG_FEATURE_ACPID_COMPAT=y
