#!/bin/sh
# Lo ultimo del arranque: la rocola en tty1. En la etapa 1 todavia es la prueba de sonido y grafica (rocola-prueba).
case "$1" in
	start)
		printf "Rocola OS: arrancando la prueba en tty1\n"
		setsid sh -c 'exec /usr/bin/rocola-prueba </dev/tty1 >/dev/tty1 2>&1' &
		;;
	stop) ;;
	*) echo "Uso: $0 {start|stop}"; exit 1 ;;
esac
exit 0
