#!/bin/sh
# Lo ultimo del arranque: la musica de los otros discos (en solo lectura: rocola-discos) y, en tty1, la prueba de sonido y grafica
# (rocola-prueba) la primera vez, que al acabar abre la rocola; despues, la rocola directo (/usr/bin/rocola).
case "$1" in
	start)
		acpid   # el boton de encendido: /etc/acpi/PWRF/00000080
		# EL INSTALADOR (la primera entrada del menu de la memoria USB): solo el, en tty1 (sin montar los discos: los monta el).
		if grep -q rocola.instalar /proc/cmdline; then
			printf "Rocola OS: arrancando el instalador en tty1\n"
			setsid sh -c 'exec /usr/bin/rocola-instalar </dev/tty1 >/dev/tty1 2>&1' &
			exit 0
		fi
		# INTERNET: el encendido remoto (Wake on LAN, el «paquete magico» que manda el router) queda encendido en la tarjeta de red, y el
		# programa de la rocola se actualiza solo (rocola-actualiza): al minuto de prender y despues cada hora, o al momento si se pide
		# desde Ctrl+F3 (/run/rocola-buscar-ya).
		ethtool -s eth0 wol g 2>/dev/null
		# EL DISCO DE LA ROCOLA, QUE NO SE QUEDE «SIN REVISAR» (A4, 7-11-2026: el instalador no pudo escribir). ntfs3 marca el NTFS sucio en
		# el disco en cuanto crea, agranda o borra un archivo, y solo lo limpia con un sync o al desmontar: un apagon en medio lo deja
		# marcado, y entonces Windows XP pide revisarlo, el instalador no escribe y el initramfs tiene que montarlo con «force». Cada 15 s,
		# si ntfs3 dice que esta sucio por lo que se escribio aqui, un sync lo limpia (sin nada escrito no hace nada). Si ya venia marcado
		# al montar (un apagon de antes), ntfs3 no lo limpia aunque se haga sync: lo revisa Windows XP al prender; se avisa en
		# /run/rocola-disco-revisar (y rocola-actualiza no escribe un sistema nuevo en el hasta entonces).
		( dev=$(awk '$2 == "/rocola/disco" {print $1; exit}' /proc/mounts); v=/proc/fs/ntfs3/${dev##*/}/volinfo
		  [ -n "$dev" ] && [ -r "$v" ] || exit 0
		  if [ "$(sed -n 6p "$v")" = dirty ]; then echo "$dev" > /run/rocola-disco-revisar; exit 0; fi
		  while sleep 15; do [ -r "$v" ] || exit 0; [ "$(sed -n 7p "$v")" = dirty ] && sync; done ) &
		# EL DESINSTALADOR PARA WINDOWS XP (7-11-2026, el dueno: «Si haz un desinstalador»): en \rocola-os, para quitar Rocola OS desde XP
		# (doble clic en Desinstalar_Rocola_OS.cmd). Se pone si falta o cambio (en las rocolas instaladas antes, con la primera
		# actualizacion); nunca con el disco «sin revisar». El sync lo hace el vigilante de arriba.
		( sleep 20; [ -d /rocola/disco/rocola-os ] && [ ! -f /run/rocola-disco-revisar ] || exit 0
		  for f in /usr/share/rocola/xp/*; do d=/rocola/disco/rocola-os/${f##*/}; cmp -s "$f" "$d" || cp -f "$f" "$d"; done ) &
		# (el aviso de «Buscar actualizacion ahora» se borra al acabar de buscar: hasta entonces Ctrl+F3 dice BUSCANDO, y
		# rocola-actualiza sabe que se pidio a mano: busca aunque «Actualizarse sola» este apagado)
		( sleep 60
		  while :; do
			pedida=; [ -f /run/rocola-buscar-ya ] && pedida=1
			ROCOLA_PEDIDA=$pedida /usr/bin/rocola-actualiza >/dev/null 2>&1
			[ -n "$pedida" ] && rm -f /run/rocola-buscar-ya
			i=0; while [ $i -lt 360 ] && [ ! -f /run/rocola-buscar-ya ]; do sleep 10; i=$((i + 1)); done
		  done ) &
		# EL BUZON (7-11-2026, rocola-buzon): trabajar en la rocola desde casa con «Rocola en casa» (sistema/casa). Sin su llave
		# (rocola_buzon.txt en una memoria USB) no hace nada.
		( sleep 90; command -v nice >/dev/null && exec nice -n 15 /usr/bin/rocola-buzon; exec /usr/bin/rocola-buzon ) >/dev/null 2>&1 &   # (prioridad baja: no le quita a la musica ni a la pantalla)
		# UN SISTEMA NUEVO EN PRUEBA (rocola-actualiza): si la rocola no lleva 3 minutos en pie a los 15 minutos de prender, se reinicia;
		# el initramfs cuenta los arranques y a la tercera vuelve al sistema anterior. Si llega, se da por bueno.
		if [ -f /rocola/disco/rocola-os/probando ]; then
			( i=0
			  while [ $i -lt 90 ] && [ ! -f /run/rocola-confirmado ]; do sleep 10; i=$((i + 1)); done
			  if [ -f /run/rocola-confirmado ]; then
				rm -f /rocola/disco/rocola-os/probando
				printf '%s  el sistema %s quedo bien\n' "$(date '+%Y-%m-%d %H:%M')" "$(cat /etc/rocola-sistema-version 2>/dev/null)" >> /rocola/disco/rocola-os/sistema.txt
			  else
				printf '%s  el sistema %s no llego a confirmarse: reinicio\n' "$(date '+%Y-%m-%d %H:%M')" "$(cat /etc/rocola-sistema-version 2>/dev/null)" >> /rocola/disco/rocola-os/sistema.txt
				sync; reboot
			  fi; sync ) &
		fi
		# V29: en tty1 no se escribe nada ni parpadea el cursor; lo que antes salia en pantalla va a /run/rocola-arranque.txt
		printf '\033[2J\033[H\033[?25l' > /dev/tty1 2>/dev/null
		echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
		printf "Rocola OS: buscando la musica en los otros discos (solo lectura)\n" >> /run/rocola-arranque.txt
		/usr/bin/rocola-discos > /run/rocola-discos.txt 2>&1
		# La prueba de sonido y grafica la primera vez (o si se elige en el menu de GRUB: rocola.prueba); despues, directo a la rocola.
		if grep -q rocola.prueba /proc/cmdline || [ ! -f /rocola/datos/prueba_hecha ]; then
			printf "Rocola OS: arrancando la prueba en tty1\n" >> /run/rocola-arranque.txt
			setsid sh -c 'exec /usr/bin/rocola-prueba </dev/tty1 >/dev/tty1 2>&1' &
		else
			printf "Rocola OS: arrancando la rocola en tty1\n" >> /run/rocola-arranque.txt
			setsid sh -c 'exec /usr/bin/rocola </dev/tty1 >/dev/tty1 2>&1' &
		fi
		;;
	stop) ethtool -s eth0 wol g 2>/dev/null ;;   # al apagar: que la tarjeta siga escuchando el encendido remoto
	*) echo "Uso: $0 {start|stop}"; exit 1 ;;
esac
exit 0
