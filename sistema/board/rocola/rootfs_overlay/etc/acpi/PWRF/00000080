#!/bin/sh
# EL BOTON DE ENCENDIDO: como en XP (donde Windows apaga y la rocola, al cerrarse, borra el estado del dia: es un CIERRE, no un apagon).
# Primero el vigilante (/usr/bin/rocola, para que no la vuelva a abrir), luego la rocola (rocola-xp) con SIGTERM (= el apagado de Windows:
# guarda lo aprendido y borra el estado; si se estaba trayendo lo aprendido de XP, eso tambien se corta), se espera a que acabe (hasta
# 20 s, lo que Windows XP le da a cada programa al apagarse: WaitToKillAppTimeout) y se apaga el equipo.
killall -TERM rocola 2>/dev/null
killall -TERM rocola-xp 2>/dev/null
i=0; while pidof rocola-xp >/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); done
sync
poweroff
