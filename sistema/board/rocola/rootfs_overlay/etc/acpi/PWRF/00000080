#!/bin/sh
# EL BOTON DE ENCENDIDO: como en XP (donde Windows apaga y la rocola, al cerrarse, borra el estado del dia: es un CIERRE, no un apagon).
# Primero el vigilante (/usr/bin/rocola, para que no la vuelva a abrir), luego la rocola con SIGTERM (guarda lo aprendido y borra el
# estado), se espera a que acabe (hasta 15 s) y se apaga el equipo.
killall -TERM rocola 2>/dev/null
killall -TERM rocola-consola 2>/dev/null
killall -TERM rocola-xp 2>/dev/null   # (la traducida de XP, si es la que corre: como el apagado de Windows, borra el estado del dia)
i=0; while pidof rocola-consola rocola-xp >/dev/null && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); done
sync
poweroff
