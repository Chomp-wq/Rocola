#!/bin/sh
# LA ROCOLA DE ROCOLA OS. Como la de XP al arrancar: el volumen general al maximo y sin silencio (en XP, VolumenWindows.cs; aqui
# los controles de la tarjeta: Master, PCM y las salidas), y la rocola en la pantalla. Si se cierra o se cae, vuelve a empezar (la
# de XP la vigilaba igual). Sus datos en /rocola/datos; lo que dice, en /root/rocola.txt (se recorta al pasar de 1 MB).
#
# LAS ACTUALIZACIONES (rocola-actualiza): el programa que corre es /rocola/datos/programa/rocola-consola si lo hay (el ultimo bajado de
# GitHub), si no el que trae el sistema. Una version nueva (rocola-consola.nueva) se pone al arrancar o cuando la rocola sale con 42
# (lo hace sola en cuanto esta libre). Si la nueva se cae dos veces en sus primeros 2 minutos, se vuelve a la anterior y se apunta como
# mala (no se vuelve a bajar).
PROG=${ROCOLA_PROG:-/rocola/datos/programa}   # (con lo aprendido: sobrevive a una actualizacion del sistema)
BITACORA=${ROCOLA_BITACORA:-/rocola/datos/rocola_actualizaciones.txt}
# el registro va con lo aprendido (3-11-2026: dentro del sistema se perdia en cada actualizacion del sistema); /root/rocola.txt lo enseña
REGISTRO=${ROCOLA_REGISTRO:-/rocola/datos/rocola.txt}   # (cambiables para probarlo fuera de la rocola)
[ -z "$ROCOLA_REGISTRO" ] && [ ! -e /root/rocola.txt ] && ln -sf "$REGISTRO" /root/rocola.txt 2>/dev/null
[ -z "$ROCOLA_REGISTRO" ] && [ -f /root/rocola.txt ] && [ ! -L /root/rocola.txt ] && { cat /root/rocola.txt >> "$REGISTRO"; ln -sf "$REGISTRO" /root/rocola.txt; } 2>/dev/null
# la tarjeta del amplificador (no la del HDMI): la musica y los videos van directos a ella, y su volumen es el que se sube (antes solo el
# de la tarjeta 0, que puede ser la del HDMI)
# LA TARJETA PUEDE LLEGAR TARDE (3-11-2026): la HDA se registra en segundo plano, a veces despues de que udev acaba, y su salida arranca
# silenciada; si el volumen se subia antes, la rocola sonaba muda todo el dia. Se espera a que aparezca (hasta 20 s) y el volumen se
# vuelve a poner cada vez que se abre la rocola.
i=0; while [ -z "$(rocola-tarjeta -c)" ] && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
export ROCOLA_ALSA=${ROCOLA_ALSA:-$(rocola-tarjeta)}
# EL MATERIAL PARA ENTRENAR LA IA (3-11-2026): puede crecer a varios GB y datos.img mide 512 MB; instalada, va al disco de la rocola, junto
# a la musica (MaterialIa.cs). Desde la memoria USB (sin ese disco) sigue en la carpeta de datos.
[ -z "$ROCOLA_IA_DATOS" ] && [ -d /rocola/disco/rocola-os ] && export ROCOLA_IA_DATOS=/rocola/disco/rocola-os/ia
# LOS «MP3» QUE NO LO SON, CONVERTIDOS A WAV (4-11-2026; Conversiones.cs): la copia va al disco de la musica, el original no se toca.
[ -z "$ROCOLA_CONVERTIDAS" ] && [ -d /rocola/disco/rocola-os ] && export ROCOLA_CONVERTIDAS=/rocola/disco/rocola-os/convertidas
# LA COPIA DE LOS BOTONES (4-11-2026; Arranque.cs: CopiaBotones): fuera de datos.img, para que se puedan usar aunque se pierda lo aprendido
[ -z "$ROCOLA_COPIAS" ] && [ -d /rocola/disco/rocola-os ] && export ROCOLA_COPIAS=/rocola/disco/rocola-os/copias
# EL PROGRAMA TRADUCIDO DE XP (rocola-xp; sistema/INTEGRACION_ROCOLA_XP.md), PREPARADO Y APAGADO. Con el archivo
# /rocola/datos/rocola_programa.txt y dentro «programa=xp» (no hay opcion en Ctrl+F3), y solo si el sistema trae
# /usr/lib/rocola-xp/rocola-xp, se abre la rocola traducida de XP en lugar de rocola-consola. Sin el archivo, o sin el programa, TODO SIGUE
# COMO SIEMPRE. Se mira en cada arranque del programa (no hace falta reiniciar el equipo). Si rocola-xp se cae 3 veces seguidas al
# arrancar, se vuelve al programa de siempre hasta el siguiente encendido (/run/rocola-xp-caida).
CUAL=${ROCOLA_CUAL:-/rocola/datos/rocola_programa.txt}
XPBIN=${ROCOLA_XP_BIN:-/usr/lib/rocola-xp/rocola-xp}
usa_xp() { [ ! -f "${ROCOLA_RUN:-/run}/rocola-xp-caida" ] && [ -x "$XPBIN" ] && grep -q '^programa=xp' "$CUAL" 2>/dev/null; }
# alguna de las dos rocolas esta abierta (sin rocola-xp en el sistema, lo mismo que «pidof rocola-consola»)
abierta() { pidof rocola-consola rocola-xp >/dev/null; }
# CERRAR rocola-xp CONSERVANDO LOS CREDITOS Y LA COLA (los reinicios propios de Rocola OS: la consola de mantenimiento, «reiniciar el
# programa ya»). En XP, y en rocola-xp, el cierre a proposito (SIGTERM = el apagado de Windows) BORRA rocola_estado.txt (regla del
# 8-11-2026); lo unico que lo conserva es el «cierre por otra causa». Esa via es SIGUSR1: rocola-xp la atiende con un cierre ORDENADO
# (guarda todo lo que XP guarda al cerrar, suelta el sonido y la tarjeta, NO borra el estado) y sale con 0. Si le llega antes de estar
# lista para atenderla (los primeros instantes del arranque) la corta en seco como un apagon y sale con 138: el estado tambien sobrevive.
# Ninguna de las dos salidas es una caida: quien llama a cierra_xp deja antes su marca (rocola-en-consola, rocola-xp-reinicio) y el bucle
# de abajo la mira antes que el codigo de salida. Si en 20 s no se cerro, se corta (SIGKILL: como un apagon) y queda apuntado. NUNCA
# SIGTERM aqui.
cierra_xp() {
	killall -USR1 rocola-xp 2>/dev/null
	i=0; while pidof rocola-xp >/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
	pidof rocola-xp >/dev/null && { killall -KILL rocola-xp 2>/dev/null; apunta "rocola-xp no se cerro en 20 s: se corto (el estado queda como tras un apagon)"; }
}
# LO QUE rocola-xp NECESITA (solo con el interruptor encendido). Deja XPDATOS y XPLETRAS.
#  - LOS DATOS: de fabrica, una carpeta propia en lo aprendido (/rocola/datos/xp): no se mezclan con los de rocola-consola (su
#    rocola_config.txt tiene otras claves) ni se escribe en la carpeta de la rocola de XP (sus tablas llevan rutas de Windows: la rocola
#    de XP, que sigue siendo la del bar, se las encontraria cambiadas). La primera vez se copian de la carpeta de XP (solo se lee) los
#    botones y los ajustes: rocola_teclas.txt y rocola_config.txt (sin los botones, rocola-xp abre la configuracion de botones).
#    Con «datos=xp» en rocola_programa.txt (DECISION DEL DUENO, no de fabrica): la carpeta de la rocola de XP que eligio rocola-discos
#    (/run/rocola-datos-xp), si se puede escribir en ella; si no, la propia. Con «datos=/una/carpeta»: esa, como propia.
#  - LA MUSICA: XP busca «musica» junto a sus datos o hasta 3 carpetas mas arriba (aqui /rocola/musica) y las de Ctrl+F2 (las lineas
#    «dir=» de rocola_config.txt): las carpetas que encontro rocola-discos (/run/rocola-musica) se apuntan asi, una vez cada una. En la
#    carpeta de XP no se apunta nada: alli XP encuentra su «musica» como siempre.
#  - LAS LETRAS DE XP: se leen del disco de Windows (\WINDOWS\Fonts) tal cual (ROCOLA_LETRAS_XP); no van en el sistema ni en el repositorio.
prepara_xp() {
	XPDATOS=${ROCOLA_XP_DATOS:-/rocola/datos/xp}; propia=1
	dexp=$(cat "${ROCOLA_RUN:-/run}/rocola-datos-xp" 2>/dev/null)
	quiere=$(sed -n 's/^datos=//p' "$CUAL" 2>/dev/null | tr -d '\r' | head -1)
	case "$quiere" in
		xp)
			if [ -n "$dexp" ] && [ -d "$dexp" ] && : 2>/dev/null > "$dexp/rocola_os_escribe.tmp"; then
				rm -f "$dexp/rocola_os_escribe.tmp"; XPDATOS=$dexp; propia=
			else echo "--- rocola-xp: no se puede escribir en la carpeta de XP (${dexp:-no hay}): datos en $XPDATOS" >> $REGISTRO; fi ;;
		/*)   # otra carpeta propia (por ejemplo en el disco de la rocola, /rocola/disco/rocola-os/xp: lo aprendido, datos.img, mide 512 MB)
			if mkdir -p "$quiere" 2>/dev/null && : 2>/dev/null > "$quiere/rocola_os_escribe.tmp"; then rm -f "$quiere/rocola_os_escribe.tmp"; XPDATOS=$quiere
			else echo "--- rocola-xp: no se puede escribir en $quiere: datos en $XPDATOS" >> $REGISTRO; fi ;;
	esac
	mkdir -p "$XPDATOS"
	if [ -n "$propia" ]; then
		if [ -n "$dexp" ] && [ ! -f "$XPDATOS/rocola_de_xp.txt" ]; then
			for n in rocola_teclas.txt rocola_config.txt; do
				[ -e "$XPDATOS/$n" ] && continue
				f=$(find "$dexp" -maxdepth 1 -type f -iname "$n" 2>/dev/null | head -1)
				[ -n "$f" ] && cp "$f" "$XPDATOS/$n" 2>/dev/null && echo "$n de $dexp" >> "$XPDATOS/rocola_de_xp.txt"
			done
			echo "mirado $dexp" >> "$XPDATOS/rocola_de_xp.txt"
		fi
		c=$XPDATOS/rocola_config.txt
		while IFS= read -r m; do
			[ -n "$m" ] && [ -d "$m" ] || continue
			tr -d '\r' < "$c" 2>/dev/null | grep -qxF "dir=$m" && continue
			[ -s "$c" ] && [ -n "$(tail -c 1 "$c")" ] && printf '\r\n' >> "$c"   # (que no se pegue a la ultima linea)
			printf 'dir=%s\r\n' "$m" >> "$c"
		done < "${ROCOLA_RUN:-/run}/rocola-musica"
	fi 2>/dev/null
	XPLETRAS=$(find /rocola/disco /rocola/discos/* -maxdepth 2 -type d -iname fonts 2>/dev/null | grep -i '/windows/fonts$' | head -1)
}
volumen() {
	T=$(rocola-tarjeta -c)
	for c in Master PCM Speaker Headphone Front "Line Out" Surround Center LFE Side; do amixer ${T:+-c $T} -q sset "$c" 100% unmute 2>/dev/null; done
	# (7-11-2026, en el A4 no se oia nada) el «silencio automatico» de las HDA (Realtek): calla la salida de atras, la del amplificador,
	# si cree que hay audifonos en el frente; y que el frente y atras suenen a la vez
	amixer ${T:+-c $T} -q sset "Auto-Mute Mode" Disabled 2>/dev/null
	amixer ${T:+-c $T} -q sset "Independent HP" off 2>/dev/null
	# (7-11-2026) si la salida elegida es la del HDMI de la pantalla (rocola-sonido usar N), su salida digital arranca en silencio
	i=0; while [ $i -lt 8 ]; do amixer ${T:+-c $T} -q sset "IEC958,$i" unmute 2>/dev/null; i=$((i + 1)); done
}
volumen
probando=0; fallos=0; rapidas=0
apunta() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$BITACORA"; echo "--- $*" >> $REGISTRO; }
pon_nueva() {
	[ -f "$PROG/rocola-consola.nueva" ] || return
	[ -f "$PROG/rocola-consola" ] && mv -f "$PROG/rocola-consola" "$PROG/rocola-consola.anterior"
	cp -f "$PROG/version" "$PROG/version.anterior" 2>/dev/null || rm -f "$PROG/version.anterior"
	mv -f "$PROG/rocola-consola.nueva" "$PROG/rocola-consola"
	mv -f "$PROG/nueva.version" "$PROG/version"
	rm -f ${ROCOLA_RUN:-/run}/rocola-hay-nueva; sync
	probando=1; fallos=0
	apunta "Se puso la version $(cat "$PROG/version")"
}
vuelve_atras() {
	mala=$(cat "$PROG/version" 2>/dev/null)
	echo "$mala" >> "$PROG/malas"
	if [ -f "$PROG/rocola-consola.anterior" ]; then mv -f "$PROG/rocola-consola.anterior" "$PROG/rocola-consola"
	else rm -f "$PROG/rocola-consola"; fi
	if [ -f "$PROG/version.anterior" ]; then mv -f "$PROG/version.anterior" "$PROG/version"; else rm -f "$PROG/version"; fi
	sync; probando=0
	apunta "La version $mala se cayo al arrancar: se volvio a la anterior"
}
# EL MAS NUEVO, EL BAJADO O EL DEL SISTEMA (7-11-2026): si el sistema se actualizo y trae un programa compilado despues que el bajado de
# GitHub, se aparta el bajado (no como malo) y se usa el del sistema; antes siempre mandaba el bajado, aunque fuera mas viejo. Cada
# programa dice cuando se compilo (--version: «compilado SEGUNDOS»); uno bajado de antes de esto no lo dice: es mas viejo.
compilado() { timeout 20 "$1" --version 2>/dev/null | sed -n 's/.* compilado \([0-9]*\).*/\1/p'; }
el_mas_nuevo() {
	[ -x "$PROG/rocola-consola" ] || return
	s=$(compilado /usr/bin/rocola-consola); [ -n "$s" ] && [ "$s" != 0 ] || return
	b=$(compilado "$PROG/rocola-consola")
	if [ -z "$b" ] || [ "$b" -lt "$s" ]; then
		v=$(cat "$PROG/version" 2>/dev/null)
		mv -f "$PROG/rocola-consola" "$PROG/rocola-consola.superada"; rm -f "$PROG/version"; sync
		apunta "El sistema trae un programa mas nuevo que la version ${v:-?} bajada: se usa el del sistema"
	fi
}
pon_nueva
el_mas_nuevo
# El sistema se da por bueno cuando la rocola lleva 3 minutos en pie (una actualizacion del sistema en prueba: S99rocola y el initramfs).
( sleep 180; while ! abierta; do sleep 10; done; touch ${ROCOLA_RUN:-/run}/rocola-confirmado ) &
# LA CONSOLA DE MANTENIMIENTO (7-11-2026: en el A4, «No puedo abrir la consola de mantenimiento con Ctrl+Alt+F2»). Ctrl+Alt+F2 si cambia a
# la consola 2 (alli espera «login»), pero la rocola seguia pintando la pantalla encima (es la duena de la tarjeta grafica) y leyendo las
# teclas. Ahora, si la consola de delante deja de ser la 1, la rocola se cierra como en una actualizacion (guarda su estado: los creditos
# y la cola vuelven; si en 20 s no se cerro, como con el boton de encendido) y no se vuelve a abrir hasta volver a la 1 (Ctrl+Alt+F1).
ACTIVA=${ROCOLA_VT_ACTIVA:-/sys/class/tty/tty0/active}
EN_CONSOLA=${ROCOLA_RUN:-/run}/rocola-en-consola
( while sleep 1; do
	a=$(cat "$ACTIVA" 2>/dev/null)
	[ -n "$a" ] && [ "$a" != tty1 ] || continue
	# (ya en la consola: si rocola-xp llego a abrirse justo al cambiar -el lanzador ya habia pasado su espera-, se cierra tambien; no mira
	# ningun aviso y se quedaria pintando encima de la consola. Sin rocola-xp abierto no hace nada)
	if [ -f "$EN_CONSOLA" ]; then pidof rocola-xp >/dev/null && cierra_xp; continue; fi
	touch "$EN_CONSOLA"
	if pidof rocola-xp >/dev/null; then cierra_xp; continue; fi   # (rocola-xp no mira el aviso: se cierra conservando el estado; nunca SIGTERM)
	touch ${ROCOLA_RUN:-/run}/rocola-reinicia-programa-ya
	i=0; while pidof rocola-consola >/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
	pidof rocola-consola >/dev/null && killall -TERM rocola-consola 2>/dev/null
	killall mpv 2>/dev/null
  done ) &
# «REINICIAR EL PROGRAMA YA» (rocola-buzon) CON rocola-xp: no mira /run/rocola-reinicia-programa-ya; lo atiende el lanzador, conservando el
# estado. (Lo de «cuando este libre» -reiniciar, apagar, el sistema nuevo, el diagnostico- espera a la fase 11: el lanzador no sabe si
# esta libre.) Sin rocola-xp abierto no hace nada.
( while sleep 5; do
	pidof rocola-xp >/dev/null && [ -f ${ROCOLA_RUN:-/run}/rocola-reinicia-programa-ya ] && [ ! -f "$EN_CONSOLA" ] || continue
	rm -f ${ROCOLA_RUN:-/run}/rocola-reinicia-programa-ya; touch ${ROCOLA_RUN:-/run}/rocola-xp-reinicio; cierra_xp
  done ) &
while :; do
	# en la consola de mantenimiento: la rocola espera a que se vuelva a la 1
	while [ -f "$EN_CONSOLA" ]; do
		[ "$(cat "$ACTIVA" 2>/dev/null)" = tty1 ] && { rm -f "$EN_CONSOLA" ${ROCOLA_RUN:-/run}/rocola-reinicia-programa-ya; break; }
		sleep 1
	done
	[ -f $REGISTRO ] && [ "$(wc -c < $REGISTRO)" -gt 1048576 ] && mv $REGISTRO $REGISTRO.1
	echo "--- $(date) arranca la rocola" >> $REGISTRO
	volumen
	BIN=/usr/bin/rocola-consola
	[ -x "$PROG/rocola-consola" ] && BIN=$PROG/rocola-consola
	t0=$(date +%s)
	if usa_xp; then
		# la rocola traducida de XP: la pantalla por KMS (sin ROCOLA_PANTALLA), el sonido por ROCOLA_ALSA (arriba), sus datos y las letras de XP
		BIN=$XPBIN; prepara_xp
		echo "--- rocola-xp ($(cat "${XPBIN%/*}/version" 2>/dev/null)): datos en $XPDATOS, letras de XP en ${XPLETRAS:-(no hay: las del sistema)}" >> $REGISTRO
		ROCOLA_DATOS=$XPDATOS ROCOLA_LETRAS_XP=$XPLETRAS "$BIN" >> $REGISTRO 2>&1
	else
		ROCOLA_DATOS=/rocola/datos "$BIN" --rocola >> $REGISTRO 2>&1
	fi
	r=$?
	duro=$(( $(date +%s) - t0 ))
	if [ -f "$EN_CONSOLA" ]; then apunta "La rocola se cerro para la consola de mantenimiento"; continue; fi   # (no es una caida)
	# (rocola-xp cerrado por el lanzador para «reiniciar el programa ya»: sale con 0 -cierre ordenado- o por la senal; no es una caida ni cuenta para las 3 seguidas)
	if [ "$BIN" = "$XPBIN" ] && [ -f ${ROCOLA_RUN:-/run}/rocola-xp-reinicio ]; then rm -f ${ROCOLA_RUN:-/run}/rocola-xp-reinicio; apunta "rocola-xp se cerro para reiniciarse (pedido desde casa)"; continue; fi
	if [ "$r" = 42 ]; then pon_nueva; continue; fi   # salio para ponerse la version nueva
	if [ "$r" = 43 ]; then apunta "Reinicio para el sistema nuevo"; sync; reboot; sleep 60; fi   # salio para el sistema nuevo (rocola-actualiza)
	if [ "$r" = 44 ]; then apunta "Apagado pedido (desde casa o Ctrl+F3)"; sync; poweroff; sleep 60; fi   # salio para apagarse (rocola-buzon: «apagar», o Ctrl+F3)
	if [ "$r" = 46 ]; then apunta "Reinicio del equipo pedido en Ctrl+F3"; sync; reboot; sleep 60; fi
	if [ "$r" = 45 ]; then   # Ctrl+F3 -> «Volver a Windows XP»: el arranque de XP de vuelta (rocola-desinstalar) y a reiniciar
		if echo SI | rocola-desinstalar >> $REGISTRO 2>&1; then apunta "Vuelta a Windows XP pedida en Ctrl+F3"; sync; reboot; sleep 60
		else apunta "No se pudo volver a Windows XP (¿Rocola OS desde la memoria USB?)"; fi
	fi
	if [ "$probando" = 1 ] && [ "$BIN" != "$XPBIN" ]; then   # (la version bajada en prueba es de rocola-consola: las caidas de rocola-xp no la culpan)
		if [ "$duro" -lt 120 ] && [ "$r" != 0 ]; then
			fallos=$((fallos + 1)); [ "$fallos" -ge 2 ] && vuelve_atras
		elif [ "$duro" -ge 120 ]; then probando=0; fi
	fi
	# SE CAE AL ARRANCAR UNA Y OTRA VEZ (aunque ya estuviera confirmada; 6-11-2026): a la tercera seguida en menos de 30 s, se aparta la
	# version bajada (como mala: no se vuelve a bajar) y se usa la que trae el sistema. Si tambien se cae, se espera mas entre intentos.
	if [ "$r" != 0 ] && [ "$duro" -lt 30 ]; then rapidas=$((rapidas + 1)); else rapidas=0; fi
	if [ "$rapidas" -ge 3 ] && [ "$BIN" = "$XPBIN" ]; then
		touch ${ROCOLA_RUN:-/run}/rocola-xp-caida
		apunta "rocola-xp se cayo 3 veces seguidas al arrancar: se usa el programa de siempre hasta el siguiente encendido"
		rapidas=0
	elif [ "$rapidas" -ge 3 ] && [ "$BIN" != /usr/bin/rocola-consola ] && [ "$probando" = 0 ]; then
		mala=$(cat "$PROG/version" 2>/dev/null)
		[ -n "$mala" ] && echo "$mala" >> "$PROG/malas"
		mv -f "$PROG/rocola-consola" "$PROG/rocola-consola.caida"; rm -f "$PROG/version"; sync
		apunta "La version $mala se cayo 3 veces seguidas al arrancar: se usa la que trae el sistema"
		rapidas=0
	fi
	if [ "$rapidas" -ge 5 ]; then sleep 30; else sleep 2; fi
done
