#!/bin/sh
# LOS AVISOS DE SPOTIFY PARA LA ROCOLA (decision del dueno del 6-11-2026). librespot lo llama en cada cambio (--onevent) con lo que pasa en
# variables: PLAYER_EVENT, TRACK_ID, NAME, ARTISTS, ALBUM, COVERS (las portadas, una por linea), DURATION_MS... Deja en
# /run/rocola-spotify/ la cancion (pista.txt, que lee Motor/Spotify.cs) y su portada (portada-ID.jpg). Solo datos de la cancion: el
# sonido no pasa por aqui y no se guarda nada en el disco.
D=${ROCOLA_RUN:-/run}/rocola-spotify
mkdir -p "$D"
case "$PLAYER_EVENT" in
	track_changed)
		una() { printf '%s' "$1" | tr '\n\r' ', ' | sed 's/, *$//'; }
		{
			echo "id=$TRACK_ID"
			echo "nombre=$(una "$NAME")"
			echo "artistas=$(una "$ARTISTS")"
			echo "disco=$(una "$ALBUM")"
			echo "dura_ms=$DURATION_MS"
		} > "$D/pista.t" && mv -f "$D/pista.t" "$D/pista.txt"
		# la portada: la primera que de (Spotify las da de varios tamanos); en segundo plano, que librespot no espere
		url=$(printf '%s\n' "$COVERS" | head -n 1)
		case "$url" in
			https://*)
				(
					find "$D" -name 'portada-*.jpg' -mmin +60 -delete 2>/dev/null
					curl -fsS --max-time 20 -o "$D/portada.t" "$url" && mv -f "$D/portada.t" "$D/portada-$TRACK_ID.jpg"
				) >/dev/null 2>&1 &
				;;
		esac
		;;
	playing|paused|stopped|session_connected|session_disconnected|unavailable)
		echo "$PLAYER_EVENT" > "$D/estado.t" && mv -f "$D/estado.t" "$D/estado.txt"
		;;
esac
exit 0
