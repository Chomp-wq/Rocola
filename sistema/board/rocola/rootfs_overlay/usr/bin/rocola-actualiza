#!/bin/sh
# LA ROCOLA SE ACTUALIZA SOLA DESDE GITHUB (peticion del dueno del 1-11-2026). Lo llama S99rocola al minuto de prender, cada hora y al
# momento si se pide desde casa (la orden buscar_actualizacion del buzon: /run/rocola-buscar-ya; entonces ROCOLA_PEDIDA=1 y busca aunque
# «Actualizarse sola» este apagado). (El boton «Buscar actualizacion ahora» de Ctrl+F3 era de rocola-consola: vuelve en la fase 11.)
#
#  1. LA LLAVE: rocola_github.txt (una llave de solo lectura del repositorio) en una memoria USB conectada, o en la carpeta de la rocola
#     de XP, se copia a /rocola/datos/rocola_github.txt. Sin llave se pregunta sin ella (el repositorio es publico).
#  2. LA HORA por NTP (las conexiones seguras la necesitan; el A4 puede traerla mal), antes que nada: tambien sin llave.
#  3. EL PROGRAMA: APAGADO (decision del dueno del 14-11-2026). El canal del programa (las versiones «programa-N» de GitHub, que bajaba a
#     /rocola/datos/programa como rocola-consola.nueva) era de rocola-consola, que se retiro: el unico programa de Rocola OS es rocola-xp
#     (/usr/lib/rocola-xp), que llega CON EL SISTEMA (su numero es el del sistema que lo trajo: «rocola-xp --version»). De ese canal no se
#     baja ni se pone nada; lo que ya hubiera en /rocola/datos/programa se queda como esta (no se borra). Vuelve cuando el programa
#     traducido se publique por ese canal (rocola-programa.yml lo compile y /usr/bin/rocola sepa ponerlo).
#  4. EL SISTEMA (solo instalado en el disco: \rocola-os\arranque.cfg): el ultimo «sistema-N» mas nuevo que el que corre y no malo
#     (\rocola-os\sistema-malas). Se baja a la otra copia (\rocola-os\a o \b), se comprueban las sumas, se descomprime entero (sin
#     huecos: escribir en el no cambia el NTFS) y se pone en arranque.cfg con \rocola-os\probando; queda el aviso
#     /run/rocola-reinicio-sistema, pero rocola-xp aun no reinicia sola «cuando esta libre» (fase 11): el sistema nuevo entra al siguiente
#     encendido (o con «reiniciar el equipo ya» desde casa). El initramfs vuelve a la anterior si la nueva no se confirma (S99rocola: que
#     rocola-xp aguante 2 minutos seguidos en pie).
# Lo que dice: /run/rocola-actualiza.txt (el estado del buzon lo sube; Ctrl+F3 lo enseñaba con rocola-consola: fase 11) y la bitacora
# /rocola/datos/rocola_actualizaciones.txt.
# Para probarlo fuera de la rocola: ROCOLA_API, ROCOLA_DATOS, ROCOLA_DISCO, ROCOLA_RUN, ROCOLA_SIN_HORA=1.
REPO=${ROCOLA_REPO:-Chomp-wq/Rocola}
API=${ROCOLA_API:-https://api.github.com}
DATOS=${ROCOLA_DATOS:-/rocola/datos}
RUN=${ROCOLA_RUN:-/run}
OS=${ROCOLA_DISCO:-/rocola/disco}/rocola-os
XPBIN=${ROCOLA_XP_BIN:-/usr/lib/rocola-xp/rocola-xp}
BITACORA=$DATOS/rocola_actualizaciones.txt
ESTADO=$RUN/rocola-actualiza.txt
TMP=$RUN/rocola-actualiza.d
estado() { echo "$(date '+%H:%M') $*" > "$ESTADO"; }
apunta() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$BITACORA"; }
# una sola a la vez (7-11-2026: un cerrojo de mas de 2 horas es de una busqueda que se mato a la fuerza: se quita; si no, ya no se buscaba
# hasta reiniciar)
[ -d "$RUN/rocola-actualiza.cerrojo" ] && [ -n "$(find "$RUN/rocola-actualiza.cerrojo" -maxdepth 0 -mmin +120 2>/dev/null)" ] && rm -rf "$RUN/rocola-actualiza.cerrojo"
mkdir "$RUN/rocola-actualiza.cerrojo" 2>/dev/null || exit 0
trap 'rm -rf "$RUN/rocola-actualiza.cerrojo" "$TMP"' EXIT
rm -rf "$TMP"; mkdir -p "$TMP"

# LA HORA, lo primero (aunque falte la llave): por NTP hasta que salga bien una vez en este arranque; y al reloj de la placa en hora
# LOCAL, como lo deja Windows XP (S02hora la lee asi al prender): XP la sigue viendo bien.
if [ -z "$ROCOLA_SIN_HORA" ] && [ ! -f "$RUN/rocola-hora" ]; then
	timeout 30 ntpd -n -q -p pool.ntp.org >/dev/null 2>&1 && touch "$RUN/rocola-hora" && hwclock -w -l 2>/dev/null
fi

# 1. LA LLAVE: de una memoria USB (aunque se conecte con la rocola prendida) o de la carpeta de XP. Solo se lee de ahi.
busca_llave() {
	for f in /rocola/discos/*/rocola_github.txt /rocola/discos/*/*/rocola_github.txt; do [ -f "$f" ] && { echo "$f"; return; }; done
	[ -s /run/rocola-datos-xp ] && f=$(find "$(cat /run/rocola-datos-xp)" -maxdepth 1 -iname rocola_github.txt 2>/dev/null | head -1) && [ -n "$f" ] && { echo "$f"; return; }
	# memorias conectadas despues de prender: se miran en solo lectura y se desmontan
	for p in /sys/class/block/*; do
		[ -e "$p/partition" ] || continue
		dev=$(basename "$p"); disco=$(basename "$(readlink -f "$p/..")")
		[ "$(cat "/sys/class/block/$disco/removable" 2>/dev/null)" = 1 ] || continue
		grep -q "^/dev/$dev " /proc/mounts && continue
		m=$TMP/usb; mkdir -p "$m"
		mount -o ro "/dev/$dev" "$m" 2>/dev/null || continue
		f=$(find "$m" -maxdepth 2 -iname rocola_github.txt 2>/dev/null | head -1)
		[ -n "$f" ] && cp "$f" "$TMP/llave.txt"
		umount "$m"
		[ -f "$TMP/llave.txt" ] && { echo "$TMP/llave.txt"; return; }
	done
}
f=$(busca_llave)
if [ -n "$f" ]; then
	nueva=$(tr -d ' \r\n\t' < "$f")
	if [ -n "$nueva" ] && [ "$nueva" != "$(cat "$DATOS/rocola_github.txt" 2>/dev/null)" ]; then
		printf '%s' "$nueva" > "$DATOS/rocola_github.txt"; chmod 600 "$DATOS/rocola_github.txt"; sync
		apunta "Llave de GitHub puesta (de $f)"
	fi
fi
LLAVE=$(cat "$DATOS/rocola_github.txt" 2>/dev/null)
# SIN LLAVE (7-11-2026: el dueno hizo publico el repositorio): se pregunta sin ella; con un repositorio privado GitHub contesta 404 y
# se dice que falta. Con llave, como siempre.
AUT=; [ -n "$LLAVE" ] && AUT="Authorization: Bearer $LLAVE"
# «Actualizarse sola» apagado (actualizar_solo=0) y no pedida a mano: nada. (Era un interruptor de Ctrl+F3 de rocola-consola, y sigue en
# su rocola_config.txt de /rocola/datos: lo que el dueno decidio vale; rocola-xp aun no lo tiene en su Ctrl+F3 -fase 11-.)
if grep -q '^actualizar_solo=0' "$DATOS/rocola_config.txt" 2>/dev/null && [ -z "$ROCOLA_PEDIDA" ]; then
	estado "apagada («Actualizarse sola»): se busca solo si se pide desde casa (buscar_actualizacion)"; exit 0
fi


pide() {   # pide RUTA_DE_LA_API ARCHIVO
	curl -fsSL --connect-timeout 20 --max-time 60 ${AUT:+-H "$AUT"} -H "Accept: application/vnd.github+json" \
		-H "X-GitHub-Api-Version: 2022-11-28" -H "User-Agent: rocola" "$API$1" -o "$2"
}
baja() {   # baja ID_DEL_ARCHIVO DESTINO (los archivos de una version; GitHub manda a otro sitio, que no recibe la llave)
	curl -fsSL --connect-timeout 20 --max-time 1800 --retry 2 ${AUT:+-H "$AUT"} -H "Accept: application/octet-stream" \
		-H "User-Agent: rocola" "$API/repos/$REPO/releases/assets/$1" -o "$2"
}
estado "buscando..."
if ! pide "/repos/$REPO/releases?per_page=50" "$TMP/versiones.json"; then
	c=$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 20 ${AUT:+-H "$AUT"} -H "User-Agent: rocola" "$API/repos/$REPO" 2>/dev/null)
	case "$c" in
		401|403|404) if [ -z "$LLAVE" ]; then estado "el repositorio es privado y falta la llave de GitHub (rocola_github.txt en una memoria USB)"
			else estado "la llave de GitHub no vale (caduco o no tiene permiso): pon otra"; apunta "La llave de GitHub no vale ($c)"; fi ;;
		000) estado "sin internet (¿el cable?)" ;;
		*) estado "GitHub no contesto ($c): se reintenta en una hora" ;;
	esac
	exit 0
fi
# la version N mas alta de un tipo (hoy solo «sistema») que no este en la lista de malas
ultima() { jq -r --arg t "$1-" '.[] | select(.draft | not) | .tag_name | select(startswith($t)) | ltrimstr($t)' "$TMP/versiones.json" 2>/dev/null \
	| grep -E '^[0-9]+$' | while read -r n; do grep -qx "$n" "$2" 2>/dev/null || echo "$n"; done | sort -n | tail -1; }
archivo() { jq -r --arg t "$1" --arg n "$2" '.[] | select(.tag_name == $t) | .assets[] | select(.name == $n) | .id' "$TMP/versiones.json" | head -1; }
# comprueba DIRECTORIO ARCHIVO...: las sumas de sha256.txt de esos archivos
comprueba() { d=$1; shift; for a in "$@"; do grep -q " $a\$" "$d/sha256.txt" || return 1; done; (cd "$d" && for a in "$@"; do grep " $a\$" sha256.txt; done | sha256sum -c -s); }
dice=

# 3. EL PROGRAMA: rocola-xp llega con el sistema (el canal «programa-N» esta apagado: arriba). Solo se dice cual corre.
ahora=$(timeout 20 "$XPBIN" --version 2>/dev/null | sed -n 's/.*programa \([0-9]*\).*/\1/p')
dice="programa rocola-xp ${ahora:-?} (llega con el sistema)"

# 4. EL SISTEMA (instalado en el disco)
if [ -f "$OS/arranque.cfg" ]; then
	sis=$(cat /etc/rocola-sistema-version 2>/dev/null); sis=${sis:-0}
	slot=$(sed -n 's/^set rocola_slot=\([ab]\).*/\1/p' "$OS/arranque.cfg"); otro=a; [ "$slot" = a ] && otro=b
	n=$(ultima sistema "$OS/sistema-malas")
	if [ -f "$OS/probando" ] || [ -f "$RUN/rocola-reinicio-sistema" ]; then
		dice="$dice; sistema nuevo en prueba"
	elif [ -n "$n" ] && [ "$n" -gt "$sis" ] && [ -f "$RUN/rocola-disco-revisar" ]; then
		# el disco vino marcado «sin revisar» (un apagon; S99rocola): un sistema nuevo son 1,4 GB que caerian en un NTFS sin revisar
		dice="$dice; sistema $n: espera a que Windows XP revise el disco (un apagon lo dejo marcado: prende en Windows XP y no toques nada mientras lo revisa)"
	elif [ -n "$n" ] && [ "$n" -gt "$sis" ]; then
		libre=$(df -k "$OS" | awk 'NR==2 {print $4}'); ocupa=$(du -sk "$OS/$otro" 2>/dev/null | awk '{print $1}')
		if [ $(( ${libre:-0} + ${ocupa:-0} )) -lt 1400000 ]; then
			dice="$dice; sistema $n: no hay sitio en el disco (hacen falta 1,4 GB)"
		else
			estado "bajando el sistema $n..."
			B=$OS/$otro/descarga; rm -rf "$B"; mkdir -p "$B"
			ok=1
			for a in sistema.img.gz bzImage initrd.gz sha256.txt; do i=$(archivo "sistema-$n" $a); [ -n "$i" ] && baja "$i" "$B/$a" || { ok=; break; }; done
			if [ -n "$ok" ] && comprueba "$B" sistema.img.gz bzImage initrd.gz; then
				estado "preparando el sistema $n..."
				# la copia que se rehace deja de servir de vuelta atras mientras tanto: el menu ya no la ofrece (no tiene sistema.img)
				rm -f "$OS/$otro/sistema.img"
				if zcat "$B/sistema.img.gz" > "$OS/$otro/sistema.img.nuevo"; then
					mv -f "$OS/$otro/sistema.img.nuevo" "$OS/$otro/sistema.img"
					mv -f "$B/bzImage" "$OS/$otro/bzImage"; mv -f "$B/initrd.gz" "$OS/$otro/initrd.gz"
					echo "$n" > "$OS/$otro/version"
					rm -rf "$B"; sync
					echo 0 > "$OS/probando"
					printf 'set rocola_slot=%s\nset rocola_otro=%s\n' "$otro" "$slot" > "$OS/arranque.cfg.nuevo" && mv -f "$OS/arranque.cfg.nuevo" "$OS/arranque.cfg"
					sync
					touch "$RUN/rocola-reinicio-sistema"
					printf '%s  bajado el sistema %s a la copia %s: entra al siguiente encendido\n' "$(date '+%Y-%m-%d %H:%M')" "$n" "$otro" >> "$OS/sistema.txt"
					apunta "Bajado el sistema $n: entra al siguiente encendido (o con «reiniciar el equipo ya» desde casa)"
					dice="$dice; sistema $n listo (entra al siguiente encendido)"
				else
					rm -f "$OS/$otro/sistema.img.nuevo"; rm -rf "$B"
					dice="$dice; no se pudo preparar el sistema $n (¿sitio en el disco?)"
				fi
			else
				rm -rf "$B"
				dice="$dice; no se pudo bajar el sistema $n (se reintenta en una hora)"
			fi
		fi
	else
		dice="$dice; sistema al dia ($sis)"
	fi
fi
estado "$dice"
exit 0
