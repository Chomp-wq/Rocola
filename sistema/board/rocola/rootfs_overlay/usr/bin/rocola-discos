#!/bin/sh
# LA MUSICA DE LOS OTROS DISCOS, EN SOLO LECTURA. Rocola OS arranca desde su memoria USB (o su particion) y la musica sigue donde
# esta: en el disco de Windows XP del A4 (NTFS) o en otra memoria USB. Este script monta cada particion que no sea la del sistema en
# /rocola/discos/<nombre>, SIEMPRE en solo lectura (no se escribe ni un byte en el disco de XP), y busca en ella carpetas "musica"
# (hasta 3 niveles: como XP, que la busca junto a sus datos o hasta tres carpetas mas arriba). En una memoria USB sin carpeta "musica"
# se usa la memoria entera. Deja la lista en /run/rocola-musica (una carpeta por linea), que la rocola suma a las suyas.
# Y LOS DATOS DE LA ROCOLA DE XP: la primera carpeta con su rocola_sonoridad.txt (o rocola_config.txt), hasta 4 niveles, va a
# /run/rocola-datos-xp; la rocola copia de ahi lo aprendido la primera vez (ImportaXP.cs). Solo se lee.
LISTA=/run/rocola-musica
# lo que no es de la rocola: la Papelera ($RECYCLE.BIN, RECYCLER de XP) y System Volume Information (en el A4 salieron datos de XP de la Papelera)
# DE VARIAS CARPETAS DE LA ROCOLA DE XP, LA QUE SE USA (7-11-2026: en el A4 habia una vieja y la de ahora en «Release1», y se tomo la
# vieja): de los archivos que llegan (uno por linea), el mas reciente; su carpeta es la de la rocola que se usa
reciente() { while IFS= read -r f; do printf '%s\t%s\n' "$(stat -c %Y "$f" 2>/dev/null || echo 0)" "$f"; done | sort -rn | head -1 | cut -f2-; }
basura() { grep -iv '/\$recycle\.bin/\|/recycler/\|/system volume information/'; }
: > "$LISTA"
rm -f /run/rocola-datos-xp
# El disco del sistema (la raiz se ve como /dev/root): por su numero de dispositivo.
RAIZ_NUM=$(mountpoint -d /)
RAIZ_DISCO=
for p in /sys/class/block/*; do [ "$(cat "$p/dev" 2>/dev/null)" = "$RAIZ_NUM" ] && RAIZ_DISCO=$(basename "$(readlink -f "$p/..")"); done
for p in /sys/class/block/*; do
	dev=$(basename "$p")
	[ -e "$p/partition" ] || continue   # solo particiones
	case "$dev" in loop*|ram*|sr*|zram*) continue ;; esac
	disco=$(basename "$(readlink -f "$p/..")")
	[ -n "$RAIZ_DISCO" ] && [ "$disco" = "$RAIZ_DISCO" ] && continue   # el disco del sistema: no
	tipo=$(blkid "/dev/$dev" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')
	case "$tipo" in
		ntfs) fs=ntfs3; opc=ro,iocharset=utf8 ;;
		vfat) fs=vfat; opc=ro,iocharset=utf8,shortname=mixed ;;
		exfat) fs=exfat; opc=ro,iocharset=utf8 ;;
		ext2|ext3|ext4) fs=$tipo; opc=ro ;;
		*) continue ;;
	esac
	m=/rocola/discos/$dev
	# Ya montada (el disco donde va instalado Rocola OS, en /rocola/disco: rocola-instalar): se busca ahi, sin montarla otra vez.
	ya=$(awk -v d="/dev/$dev" '$1 == d {print $2; exit}' /proc/mounts)
	if [ -n "$ya" ]; then m=$ya
	else
		mkdir -p "$m"
		mountpoint -q "$m" || mount -t "$fs" -o "$opc" "/dev/$dev" "$m" 2>/dev/null || { rmdir "$m" 2>/dev/null; continue; }
	fi
	encontradas=$(find "$m" -maxdepth 3 -type d -iname musica 2>/dev/null | basura)
	if [ -n "$encontradas" ]; then
		echo "$encontradas" >> "$LISTA"
	elif [ "$(cat "/sys/class/block/$disco/removable" 2>/dev/null)" = 1 ]; then
		echo "$m" >> "$LISTA"   # una memoria USB sin carpeta "musica": entera
	fi
	if [ ! -s /run/rocola-datos-xp ]; then
		xp=$(find "$m" -maxdepth 4 \( -iname rocola_sonoridad.txt -o -iname rocola_config.txt -o -iname rocola_stats.txt \) 2>/dev/null | basura | grep -iv respaldo | reciente)   # (no la copia de respaldo)
		[ -n "$xp" ] && dirname "$xp" > /run/rocola-datos-xp && echo "rocola-discos: datos de la rocola de XP en $(dirname "$xp")"
	fi
	# LAS LETRAS DE LA ROCOLA DE XP (Microsoft Sans Serif, Trebuchet MS, Tahoma, Segoe UI, Arial): Rocola OS no las trae (son de
	# Windows); si el disco de XP las tiene, se copian una vez a /rocola/datos/letras para que la pantalla use las mismas (Letras.cs).
	# Del disco solo se lee.
	if [ "$tipo" = ntfs ]; then
		fuentes=$(find "$m" -maxdepth 2 -type d -iname fonts 2>/dev/null | grep -i '/windows/fonts$' | head -1)
		if [ -n "$fuentes" ]; then
			mkdir -p /rocola/datos/letras
			n=0
			for f in "$fuentes"/*; do
				b=$(basename "$f" | tr 'A-Z' 'a-z')
				case "$b" in micross.ttf|trebuc*.ttf|tahoma*.ttf|segoeui*.ttf|arial.ttf|arialbd.ttf) ;; *) continue ;; esac
				[ -e "/rocola/datos/letras/$b" ] && continue
				cp "$f" "/rocola/datos/letras/$b" 2>/dev/null && n=$((n + 1))
			done
			[ "$n" -gt 0 ] && echo "rocola-discos: $n letras de Windows copiadas de $fuentes"
		fi
	fi
	echo "rocola-discos: /dev/$dev ($tipo) en $m$([ -n "$ya" ] || echo ', solo lectura')"
done
echo "rocola-discos: musica en: $(tr '\n' ' ' < "$LISTA")"
